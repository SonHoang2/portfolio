---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
const links = site.nav.filter((item) => site.showBlog || item.href !== '/blog/');
---

<header class="header">
  <div class="wrap inner">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <span class="mark" aria-hidden="true">{site.monogram}</span>
      <span class="name">{site.name}</span>
    </a>
    <nav aria-label="Main navigation">
      <ul>
        {
          links.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 2.5rem);
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    justify-self: start;
    text-decoration: none;
    font-weight: 500;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  nav ul {
    display: flex;
    gap: clamp(0.85rem, 2.5vw, 2.25rem);
  }

  nav a {
    position: relative;
    display: block;
    padding-block: 0.5rem;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0.3rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (max-width: 47.99rem) {
    .header { position: static; }
    .name { display: none; }
    .inner {
      grid-template-columns: 1fr auto;
      row-gap: 0;
      padding-block: 0.6rem 0.2rem;
    }
    nav { grid-column: 1 / -1; grid-row: 2; }
    nav ul { justify-content: space-between; }
    nav a { padding-block: 0.65rem; }
  }
</style>
