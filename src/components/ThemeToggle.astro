<button class="toggle" type="button" data-theme-toggle aria-label="Toggle light or dark theme">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <mask id="theme-moon-cut">
      <rect width="24" height="24" fill="#fff"></rect>
      <circle class="cut" cx="17" cy="7" r="6.5" fill="#000"></circle>
    </mask>
    <circle class="core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#theme-moon-cut)"></circle>
    <path
      class="rays"
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </svg>
</button>

<style>
  .toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: none;
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  svg * {
    transform-box: view-box;
    transform-origin: center;
    transition: transform 0.5s var(--ease), opacity 0.3s;
  }
  .cut { transform: translate(9px, -9px); }

  :global([data-theme='dark']) .cut { transform: none; }
  :global([data-theme='dark']) .core { transform: scale(1.65); }
  :global([data-theme='dark']) .rays { transform: rotate(45deg) scale(0.5); opacity: 0; }
</style>

<script>
  type Theme = 'light' | 'dark';

  const KEY = 'theme';
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function readSaved(): Theme | null {
    try {
      const value = localStorage.getItem(KEY);
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function save(theme: Theme) {
    try {
      localStorage.setItem(KEY, theme);
    } catch {
      /* Storage blocked: the theme still changes for this session. */
    }
  }

  function syncInterface() {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    button?.setAttribute('aria-label', `Switch to ${next} theme`);
    button?.setAttribute('title', `Switch to ${next} theme`);

    // Match the mobile address bar to the active theme.
    const background = getComputedStyle(document.body).backgroundColor;
    document
      .querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')
      .forEach((meta) => (meta.content = background));
  }

  function apply(theme: Theme) {
    root.dataset.theme = theme;
    syncInterface();
  }

  function switchWithReveal(theme: Theme, x: number, y: number) {
    if (!document.startViewTransition || reducedMotion.matches) {
      apply(theme);
      return;
    }

    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.classList.add('theme-switching');
    const transition = document.startViewTransition(() => apply(theme));

    transition.ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 550, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
    transition.finished.finally(() => root.classList.remove('theme-switching'));
  }

  button?.addEventListener('click', () => {
    const theme: Theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const rect = button.getBoundingClientRect();
    save(theme);
    switchWithReveal(theme, rect.left + rect.width / 2, rect.top + rect.height / 2);
  });

  // Follow the OS until the user picks a theme.
  systemDark.addEventListener('change', (event) => {
    if (!readSaved()) apply(event.matches ? 'dark' : 'light');
  });

  // Sync across open tabs.
  window.addEventListener('storage', (event) => {
    if (event.key === KEY) apply(readSaved() ?? (systemDark.matches ? 'dark' : 'light'));
  });

  syncInterface();
</script>
