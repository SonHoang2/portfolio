---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap inner">
    <p class="label">© {year} {site.name}</p>
    <ul>
      {
        site.socials.map((social) => (
          <li>
            <a class="label" href={social.href} rel="me noopener" target="_blank">
              {social.label}
            </a>
          </li>
        ))
      }
      {site.showBlog && <li><a class="label" href="/rss.xml">RSS</a></li>}
    </ul>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
  }
  ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  a { display: inline-block; padding-block: 0.35rem; text-decoration: none; }
  a:hover { color: var(--accent); }
</style>
