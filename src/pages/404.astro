---
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist or has moved." noindex>
  <section class="page-head wrap">
    <p class="label">Error 404</p>
    <h1>You seem lost.</h1>
    <p>This page does not exist or has moved.</p>
    <p><a class="arrow-link" href={withBase('/')}>Back to home</a></p>
  </section>
</BaseLayout>
